# ============================================================================
# aegis-swarm-kernel Environment Configuration Template
# ============================================================================

# --- Financial & Token Budget Controls ---
AEGIS_SWARM_DEFAULT_DAG_BUDGET_USD=0.50
AEGIS_SWARM_DEFAULT_NODE_TOKEN_CAP=4000
AEGIS_SWARM_COOLDOWN_SEC=300.0
AEGIS_SWARM_LOCK_TTL_SEC=120.0
AEGIS_SWARM_PRUNE_THRESHOLD=0.3

# --- Shared Episodic Vector Memory (Qdrant) ---
AEGIS_SWARM_QDRANT_IN_MEMORY=true
AEGIS_SWARM_QDRANT_HOST=localhost
AEGIS_SWARM_QDRANT_PORT=6333
AEGIS_SWARM_COLLECTION_NAME=aegis_swarm_shared_memory

# --- Dual Transport Configuration (stdio | sse) ---
AEGIS_SWARM_TRANSPORT=stdio
AEGIS_SWARM_HOST=127.0.0.1
AEGIS_SWARM_PORT=8080

